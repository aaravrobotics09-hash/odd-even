### 6. `src/utils/botAI.js`

Guarantees the bot picks its number **independently before** the player's gesture is confirmed or revealed. Difficulty (`easy`, `medium`, `hard`) adjusts statistical weighting from *previously completed* balls and match situation without ever reading the current gesture.

```js
export function pickBotTossCall() {
  return Math.random() < 0.5 ? 'ODD' : 'EVEN';
}

export function pickBotBatOrBowl(difficulty = 'medium') {
  // Sensible strategy: chasing gives clarity, batting first builds scoreboard pressure
  const chaseBias = difficulty === 'hard' ? 0.62 : difficulty === 'medium' ? 0.52 : 0.45;
  return Math.random() < chaseBias ? 'BOWL' : 'BAT';
}

/**
 * Picks a random number 1..9 independently of the player's current turn.
 * @param {object} ctx
 * @param {'easy'|'medium'|'hard'} ctx.difficulty
 * @param {'TOSS'|'BATTING'|'BOWLING'} ctx.role
 * @param {number[]} ctx.playerPastNumbers - Strictly past completed balls only
 * @param {number|null} ctx.runsNeeded
 */
export function selectBotNumber({
  difficulty = 'medium',
  role = 'TOSS',
  playerPastNumbers = [],
  runsNeeded = null,
}) {
  // Base equal weights for 1..9
  const weights = Array(9).fill(1);

  if (role === 'TOSS') {
    // Purely uniform 1..9 for toss
    return Math.floor(Math.random() * 9) + 1;
  }

  if (difficulty === 'easy') {
    // Slightly favors lower/classic numbers, completely random
    for (let i = 0; i < 6; i++) weights[i] = 1.15;
  } else if (difficulty === 'medium' || difficulty === 'hard') {
    if (role === 'BATTING') {
      // Smart chase logic when bot knows the exact runs needed
      if (runsNeeded !== null && runsNeeded > 0) {
        if (runsNeeded <= 4) {
          // Prefer safer low numbers to seal the chase
          for (let n = 1; n <= Math.min(6, runsNeeded + 1); n++) {
            weights[n - 1] += difficulty === 'hard' ? 1.4 : 0.7;
          }
        } else if (runsNeeded >= 12) {
          // Push scoring rate with bigger shots
          for (let n = 6; n <= 9; n++) {
            weights[n - 1] += difficulty === 'hard' ? 1.2 : 0.6;
          }
        }
      }
      // Avoid repeating numbers the player bowled frequently in past balls
      if (difficulty === 'hard' && playerPastNumbers.length >= 2) {
        const recent = playerPastNumbers.slice(-4);
        recent.forEach((n) => {
          weights[n - 1] = Math.max(0.45, weights[n - 1] - 0.28);
        });
      }
    } else if (role === 'BOWLING') {
      // Analyze player's historical favorites from completed balls only
      const lookback = difficulty === 'hard' ? 6 : 3;
      const boost = difficulty === 'hard' ? 0.55 : 0.25;
      const recent = playerPastNumbers.slice(-lookback);
      recent.forEach((n) => {
        weights[n - 1] += boost;
      });
    }
  }

  const total = weights.reduce((acc, w) => acc + w, 0);
  let r = Math.random() * total;
  for (let i = 0; i < 9; i++) {
    r -= weights[i];
    if (r <= 0) return i + 1;
  }
  return Math.floor(Math.random() * 9) + 1;
}

const QUIPS = {
  botScoredBig: [
    'BOOM! Cleared the floodlights!',
    'Maximum power! Try stopping that one!',
    'Pure timing! Straight over long-on!',
    'That ball is still orbiting the stadium!',
  ],
  botScoredSmall: [
    'Rotating the strike nicely.',
    'Smart cricket, keeping the board ticking.',
    'Quick single-style nudges add up!',
  ],
  botOut: [
    'WAIT WHAT?! How did you read my circuits?!',
    'Nooo! Right into the stumps!',
    'Glitch in my batting matrix... well bowled!',
  ],
  botTookWicket: [
    'CLEAN BOWLED! Walk back to the pavilion!',
    'Read you like an open playbook! OUT!',
    'Timber!! Stumps flying everywhere!',
  ],
  botMissedWicket: [
    'So close! Missed the edge by a millimeter!',
    'Good shot. Next ball has your name on it!',
    'Wait till my next delivery!',
  ],
  botWonToss: [
    'Toss champion! My probability core never lies.',
    'Luck and logic on my side today!',
  ],
  botLostToss: [
    'Enjoy the toss — the match is where I shine!',
    'Fair call! Let’s see how you handle the pitch.',
  ],
};

export function getBotReaction(eventType) {
  const list = QUIPS[eventType] || ['Ready for the next delivery!'];
  return list[Math.floor(Math.random() * list.length)];
}
