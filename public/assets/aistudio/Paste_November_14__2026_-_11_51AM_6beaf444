### 12. `src/components/WebcamPanel.jsx`

Loads MediaPipe `HandLandmarker` (`@mediapipe/tasks-vision`)[[1](https://www.google.com/url?sa=E&q=https%3A%2F%2Fvertexaisearch.cloud.google.com%2Fgrounding-api-redirect%2FAUZIYQEKLOgZvHqfzAEL_fKYetpIzDCSfmlCAV4R96aXjoGlFopZADr6SaiJ6cdXarNUM0OpB51QDv4yMTi7A-Z_PFee0UpiZtuWWW3VbyQ_OAxuhUBw8f2t0-zhKlSaAeNktDdd_mROSWOIGRaDthDk1EREYKIkPGRSHhai5HESvOUOUOwXCA%3D%3D)], draws real-time 21-point hand landmarks on the mirrored canvas, tracks stability to lock numbers 1–9 cleanly, and seamlessly provides a fallback 1–9 gesture pad when Webcam is toggled OFF or camera permission is unavailable.

```jsx
import React, { useEffect, useRef, useState } from 'react';
import { FilesetResolver, HandLandmarker } from '@mediapipe/tasks-vision';
import { recognizeCustomHandGesture, GestureStabilityTracker } from '../utils/gestureRecognizer';
import HandIcon from './HandIcon';

const HAND_CONNECTIONS = [
  [0, 1], [1, 2], [2, 3], [3, 4],
  [0, 5], [5, 6], [6, 7], [7, 8],
  [5, 9], [9, 10], [10, 11], [11, 12],
  [9, 13], [13, 14], [14, 15], [15, 16],
  [13, 17], [0, 17], [17, 18], [18, 19], [19, 20],
];

export default function WebcamPanel({
  webcamEnabled,
  canLock,
  turnId,
  onConfirmNumber,
  onEnableFallback,
}) {
  const videoRef = useRef(null);
  const canvasRef = useRef(null);
  const landmarkerRef = useRef(null);
  const streamRef = useRef(null);
  const rafRef = useRef(null);
  const trackerRef = useRef(new GestureStabilityTracker(750));
  const lastVideoTimeRef = useRef(-1);
  const lastTimestampRef = useRef(0);

  // Refs to avoid restarting webcam loop when turn props change
  const canLockRef = useRef(canLock);
  const onConfirmRef = useRef(onConfirmNumber);
  const lockedTurnRef = useRef(-1);

  useEffect(() => {
    canLockRef.current = canLock;
  }, [canLock]);

  useEffect(() => {
    onConfirmRef.current = onConfirmNumber;
  }, [onConfirmNumber]);

  useEffect(() => {
    trackerRef.current.reset();
    setStabilityProgress(0);
    setDetectedNum(null);
  }, [turnId]);

  const [cameraStatus, setCameraStatus] = useState('idle'); // idle | loading | ready | error
  const [errorMessage, setErrorMessage] = useState('');
  const [detectedNum, setDetectedNum] = useState(null);
  const [hint, setHint] = useState('Show hand gesture 1–9');
  const [stabilityProgress, setStabilityProgress] = useState(0);
  const [fingerState, setFingerState] = useState(null);

  useEffect(() => {
    if (!webcamEnabled) {
      if (rafRef.current) cancelAnimationFrame(rafRef.current);
      if (streamRef.current) {
        streamRef.current.getTracks().forEach((t) => t.stop());
        streamRef.current = null;
      }
      setCameraStatus('idle');
      return;
    }

    let cancelled = false;

    async function setupVisionAndCamera() {
      setCameraStatus('loading');
      setErrorMessage('');

      try {
        if (!landmarkerRef.current) {
          const vision = await FilesetResolver.forVisionTasks(
            'https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.18/wasm'
          );
          const modelPath =
            'https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task';

          try {
            landmarkerRef.current = await HandLandmarker.createFromOptions(vision, {
              baseOptions: { modelAssetPath: modelPath, delegate: 'GPU' },
              runningMode: 'VIDEO',
              numHands: 1,
              minHandDetectionConfidence: 0.6,
              minHandPresenceConfidence: 0.6,
              minTrackingConfidence: 0.6,
            });
          } catch {
            // Fallback to CPU delegate if GPU delegate is unsupported
            landmarkerRef.current = await HandLandmarker.createFromOptions(vision, {
              baseOptions: { modelAssetPath: modelPath, delegate: 'CPU' },
              runningMode: 'VIDEO',
              numHands: 1,
              minHandDetectionConfidence: 0.6,
              minHandPresenceConfidence: 0.6,
              minTrackingConfidence: 0.6,
            });
          }
        }

        if (cancelled) return;

        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'user', width: { ideal: 640 }, height: { ideal: 480 } },
          audio: false,
        });

        if (cancelled) {
          stream.getTracks().forEach((t) => t.stop());
          return;
        }

        streamRef.current = stream;
        const video = videoRef.current;
        if (!video) return;

        video.srcObject = stream;
        await video.play();
        setCameraStatus('ready');

        const renderLoop = () => {
          if (cancelled) return;
          const v = videoRef.current;
          const canvas = canvasRef.current;
          const detector = landmarkerRef.current;

          if (v && canvas && detector && v.readyState >= 2 && v.videoWidth > 0) {
            if (canvas.width !== v.videoWidth || canvas.height !== v.videoHeight) {
              canvas.width = v.videoWidth;
              canvas.height = v.videoHeight;
            }

            if (v.currentTime !== lastVideoTimeRef.current) {
              lastVideoTimeRef.current = v.currentTime;
              const now = Math.max(performance.now(), lastTimestampRef.current + 1);
              lastTimestampRef.current = now;

              const results = detector.detectForVideo(v, now);
              const ctx = canvas.getContext('2d');
              ctx.clearRect(0, 0, canvas.width, canvas.height);

              if (results.landmarks && results.landmarks.length > 0) {
                const lm = results.landmarks[0];
                const aspect = v.videoWidth / v.videoHeight;
                const recognition = recognizeCustomHandGesture(lm, aspect);

                setDetectedNum(recognition.number);
                setHint(recognition.hint);
                setFingerState(recognition.fingers);

                // Draw hand skeleton
                ctx.lineWidth = 3;
                ctx.strokeStyle = recognition.number ? '#10b981' : '#38bdf8';
                for (const [a, b] of HAND_CONNECTIONS) {
                  ctx.beginPath();
                  ctx.moveTo(lm[a].x * canvas.width, lm[a].y * canvas.height);
                  ctx.lineTo(lm[b].x * canvas.width, lm[b].y * canvas.height);
                  ctx.stroke();
                }

                for (let i = 0; i < lm.length; i++) {
                  const isTip = i === 4 || i === 8 || i === 12 || i === 16 || i === 20;
                  ctx.beginPath();
                  ctx.arc(
                    lm[i].x * canvas.width,
                    lm[i].y * canvas.height,
                    isTip ? 5.5 : 3.5,
                    0,
                    Math.PI * 2
                  );
                  ctx.fillStyle = isTip ? '#fbbf24' : '#ffffff';
                  ctx.fill();
                }

                // Stability check & lock
                if (canLockRef.current && lockedTurnRef.current !== turnId) {
                  const stability = trackerRef.current.update(recognition.number, now);
                  setStabilityProgress(stability.progress);
                  if (stability.stableNumber !== null) {
                    lockedTurnRef.current = turnId;
                    trackerRef.current.reset();
                    setStabilityProgress(1);
                    onConfirmRef.current(stability.stableNumber);
                  }
                } else {
                  setStabilityProgress(0);
                }
              } else {
                setDetectedNum(null);
                setFingerState(null);
                setHint('Place your hand inside the frame');
                const stability = trackerRef.current.update(null, now);
                setStabilityProgress(stability.progress);
              }
            }
          }

          rafRef.current = requestAnimationFrame(renderLoop);
        };

        rafRef.current = requestAnimationFrame(renderLoop);
      } catch (err) {
        if (!cancelled) {
          setCameraStatus('error');
          setErrorMessage(
            err?.name === 'NotAllowedError'
              ? 'Camera permission denied. Allow webcam access or switch to Manual Pad.'
              : 'Could not initialize webcam or MediaPipe Hands.'
          );
        }
      }
    }

    setupVisionAndCamera();

    return () => {
      cancelled = true;
      if (rafRef.current) cancelAnimationFrame(rafRef.current);
      if (streamRef.current) {
        streamRef.current.getTracks().forEach((t) => t.stop());
        streamRef.current = null;
      }
    };
  }, [webcamEnabled, turnId]);

  if (!webcamEnabled) {
    return (
      <div className="webcam-panel webcam-panel--pad">
        <div className="panel-header">
          <span>🖐️ GESTURE PAD (WEBCAM OFF)</span>
          <span className="status-chip">MANUAL MODE</span>
        </div>
        <p className="pad-subtitle">
          Select your hand gesture (1–9) to play simultaneously against the Bot:
        </p>
        <div className="gesture-pad-grid">
          {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((num) => (
            <button
              key={num}
              type="button"
              disabled={!canLock}
              className="pad-btn"
              onClick={() => onConfirmNumber(num)}
            >
              <HandIcon number={num} size={42} />
              <span className="pad-num">{num}</span>
            </button>
          ))}
        </div>
      </div>
    );
  }

  return (
    <div className="webcam-panel">
      <div className="panel-header">
        <span>📷 LIVE HAND TRACKER</span>
        <span className={`status-chip status-chip--${cameraStatus}`}>
          {cameraStatus === 'ready'
            ? 'TRACKING LIVE'
            : cameraStatus === 'loading'
            ? 'LOADING AI...'
            : cameraStatus === 'error'
            ? 'CAM ERROR'
            : 'OFF'}
        </span>
      </div>

      <div className="webcam-viewport">
        <video ref={videoRef} playsInline muted className="webcam-video" />
        <canvas ref={canvasRef} className="webcam-canvas" />

        {cameraStatus === 'loading' && (
          <div className="webcam-overlay-msg">
            <div className="spinner" />
            <p>Loading MediaPipe Hand Tracker & Camera...</p>
          </div>
        )}

        {cameraStatus === 'error' && (
          <div className="webcam-overlay-msg webcam-overlay-msg--error">
            <p>{errorMessage}</p>
            <button type="button" className="btn btn-primary btn-sm" onClick={onEnableFallback}>
              Play With On-Screen Gesture Pad
            </button>
          </div>
        )}

        {cameraStatus === 'ready' && (
          <>
            <div className={`detected-badge ${detectedNum ? 'is-valid' : ''}`}>
              <span className="detected-label">GESTURE</span>
              <strong>{detectedNum ?? '—'}</strong>
            </div>

            {canLock && (
              <div className="stability-bar-wrap">
                <div className="stability-bar-label">
                  {stabilityProgress > 0.05
                    ? `HOLD STEADY TO LOCK (${Math.round(stabilityProgress * 100)}%)`
                    : 'SHOW NUMBER (1–9)'}
                </div>
                <div className="stability-track">
                  <div
                    className="stability-fill"
                    style={{ width: `${Math.round(stabilityProgress * 100)}%` }}
                  />
                </div>
              </div>
            )}
          </>
        )}
      </div>

      <div className="webcam-telemetry">
        <span className="telemetry-hint">{hint}</span>
        {fingerState && (
          <div className="finger-pills">
            {['thumb', 'index', 'middle', 'ring', 'pinky'].map((f) => {
              const st = fingerState[f];
              const active = st === 'raised' || st === 'extended';
              return (
                <span key={f} className={`finger-pill ${active ? 'is-up' : ''}`}>
                  {f[0].toUpperCase()}
                </span>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
}
