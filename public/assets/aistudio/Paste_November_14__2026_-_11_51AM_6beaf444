}
.hand-icon .hand-crease {
  stroke: #475569;
  stroke-width: 2;
  stroke-linecap: round;
}
.hand-icon .hand-arrow {
  stroke: #fbbf24;
  stroke-width: 3;
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.hand-icon .hand-touch-ring {
  fill: none;
  stroke: #fbbf24;
  stroke-width: 2.5;
}

/* ================= CENTER CARDS (TOSS / DECISION / BREAK / RESULT) ================= */
.center-card {
  width: min(740px, 100%);
  margin: 0 auto;
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  backdrop-filter: blur(14px);
  border-radius: 22px;
  padding: 32px 26px;
  text-align: center;
  box-shadow: 0 24px 55px rgba(0, 0, 0, 0.5);
  animation: fadeSlideIn 0.3s ease;
}

@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(10px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.stage-tag {
  display: inline-block;
  padding: 4px 12px;
  border-radius: 999px;
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  background: rgba(251, 191, 36, 0.16);
  color: var(--gold);
  border: 1px solid rgba(251, 191, 36, 0.35);
  margin-bottom: 10px;
}

.center-card h2 {
  font-family: 'Teko', sans-serif;
  font-size: clamp(2.1rem, 4vw, 3.1rem);
  margin: 0 0 10px;
  letter-spacing: 0.03em;
}

.center-card p {
  color: #cbd5e1;
  margin: 0 0 22px;
}

.toss-choice-buttons,
.decision-buttons {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.toss-option-btn,
.decision-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 26px 18px;
  border-radius: 18px;
  border: 2px solid rgba(148, 163, 184, 0.25);
  background: rgba(15, 23, 42, 0.88);
  color: #fff;
  cursor: pointer;
  transition: transform 0.18s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.toss-option-btn:hover,
.decision-btn:hover {
  transform: translateY(-4px);
  border-color: var(--cyan);
  box-shadow: 0 14px 30px rgba(34, 211, 238, 0.2);
}

.toss-opt-title {
  font-family: 'Teko', sans-serif;
  font-size: 2.6rem;
  line-height: 1;
}
.toss-option-btn--odd .toss-opt-title { color: var(--gold); }
.toss-option-btn--even .toss-opt-title { color: var(--cyan); }
.toss-opt-sub { font-size: 0.84rem; color: var(--text-muted); }

.dec-icon { font-size: 2.2rem; }
.decision-btn strong { font-size: 1.25rem; }
.decision-btn span:last-child { font-size: 0.85rem; color: var(--text-muted); }

.toss-breakdown {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--border-glass);
  border-radius: 14px;
  padding: 14px 18px;
  margin-bottom: 22px;
  display: grid;
  gap: 10px;
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  font-size: 0.95rem;
}
.breakdown-row span { color: var(--text-muted); }

.text-win { color: var(--emerald); }
.text-lose { color: var(--gold); }

.bot-decision-anim {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.bot-decision-title {
  color: var(--gold);
}

/* ================= CRICKET SCOREBOARD ================= */
.cricket-scoreboard {
  position: relative;
  z-index: 6;
  width: min(1240px, 95vw);
  margin: 14px auto 0;
  background: linear-gradient(90deg, rgba(15, 23, 42, 0.95), rgba(17, 36, 72, 0.95));
  border: 1px solid rgba(56, 189, 248, 0.35);
  border-radius: 16px;
  padding: 12px 18px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}

.sb-teams {
  display: flex;
  align-items: center;
  gap: 14px;
}

.sb-team {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 5px 12px;
  border-radius: 10px;
  background: rgba(2, 6, 23, 0.55);
  border: 1px solid transparent;
}

.sb-team--active {
  border-color: var(--emerald);
  box-shadow: 0 0 14px rgba(16, 185, 129, 0.25);
}

.sb-label {
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

.sb-score {
  font-family: 'Teko', sans-serif;
  font-size: 1.9rem;
  line-height: 1;
  color: #fff;
}

.score-pop {
  animation: scorePop 0.35s ease;
}

@keyframes scorePop {
  0% { transform: scale(1); }
  50% { transform: scale(1.22); color: var(--gold); }
  100% { transform: scale(1); }
}

.sb-divider {
  font-weight: 800;
  font-size: 0.78rem;
  color: var(--cyan);
}

.sb-meta {
  display: flex;
  gap: 10px;
}

.sb-pill {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--border-glass);
  border-radius: 10px;
  padding: 5px 12px;
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 0.82rem;
}

.sb-pill span { color: var(--text-muted); }
.sb-pill strong { color: #fff; font-size: 0.96rem; }
.sb-pill--gold { border-color: rgba(251, 191, 36, 0.5); }
.sb-pill--gold strong { color: var(--gold); }

.sb-last-ball {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.84rem;
}

.sb-last-nums span {
  color: var(--text-muted);
  margin-right: 6px;
}

.sb-last-result {
  padding: 5px 11px;
  border-radius: 8px;
  font-weight: 800;
  background: rgba(51, 65, 85, 0.7);
}
.sb-last-result.is-runs {
  background: rgba(16, 185, 129, 0.22);
  color: #34d399;
  border: 1px solid rgba(16, 185, 129, 0.45);
}
.sb-last-result.is-out {
  background: rgba(239, 68, 68, 0.25);
  color: #fca5a5;
  border: 1px solid rgba(239, 68, 68, 0.55);
}

.sb-timeline {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 6px;
  padding-top: 8px;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
}

.timeline-chip {
  min-width: 28px;
  height: 26px;
  padding: 0 7px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.78rem;
  font-weight: 800;
  background: rgba(30, 41, 59, 0.95);
  border: 1px solid rgba(148, 163, 184, 0.25);
}
.timeline-chip.chip-big {
  background: rgba(251, 191, 36, 0.2);
  color: var(--gold);
  border-color: var(--gold);
}
.timeline-chip.chip-out {
  background: rgba(239, 68, 68, 0.25);
  color: #fca5a5;
  border-color: var(--crimson);
}

/* ================= MATCH ARENA ================= */
.match-arena {
  display: grid;
  grid-template-columns: 1.15fr 1fr 0.85fr;
  gap: 18px;
  align-items: start;
}

.arena-col {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ================= AVATARS ================= */
.avatar-card {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  backdrop-filter: blur(12px);
  border-radius: 18px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 6px;
}

.avatar-card.is-batting {
  border-color: rgba(16, 185, 129, 0.6);
  box-shadow: 0 0 24px rgba(16, 185, 129, 0.16);
}

.avatar-badge {
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  padding: 3px 10px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid var(--border-glass);
  color: var(--cyan);
}

.avatar-svg {
  width: 82px;
  height: 82px;
}

.bot-antenna-pulse {
  animation: antennaGlow 1.5s ease-in-out infinite alternate;
}

@keyframes antennaGlow {
  from { opacity: 0.55; }
  to { opacity: 1; }
}

.avatar-name {
  font-family: 'Teko', sans-serif;
  font-size: 1.45rem;
  line-height: 1;
}

.avatar-status {
  font-size: 0.82rem;
  color: var(--text-muted);
}

.bot-speech-bubble {
  margin-top: 4px;
  padding: 9px 12px;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(56, 189, 248, 0.28);
  font-size: 0.84rem;
  color: #e2e8f0;
  line-height: 1.35;
}

/* ================= CLASH CENTER PANEL ================= */
.clash-panel {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  backdrop-filter: blur(14px);
  border-radius: 20px;
  padding: 22px 18px;
  text-align: center;
}

.innings-banner {
  display: inline-block;
  padding: 6px 16px;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(16, 185, 129, 0.2), rgba(34, 211, 238, 0.2));
  border: 1px solid rgba(16, 185, 129, 0.5);
  font-weight: 800;
  font-size: 0.88rem;
  letter-spacing: 0.08em;
  margin-bottom: 10px;
}

.chase-tracker {
  font-size: 0.9rem;
  color: var(--gold);
  margin-bottom: 12px;
}

.clash-headline {
  font-family: 'Teko', sans-serif;
  font-size: 2.3rem;
  margin: 0 0 4px;
}

.clash-sub {
  margin: 0 0 16px;
  font-size: 0.9rem;
  color: #cbd5e1;
}

.clash-cards {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin: 16px 0;
}

.num-card {
  width: 104px;
  height: 122px;
  border-radius: 16px;
  background: rgba(15, 23, 42, 0.92);
  border: 2px solid rgba(56, 189, 248, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.25s ease;
}

.num-card--bot {
  border-color: rgba(245, 158, 11, 0.4);
}

.num-card.is-revealed {
  transform: scale(1.06);
  box-shadow: 0 0 26px rgba(34, 211, 238, 0.28);
}

.num-card-label {
  font-size: 0.68rem;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

.num-card strong {
  font-family: 'Teko', sans-serif;
  font-size: 3.4rem;
  line-height: 1;
  margin-top: 4px;
}

.clash-plus,
.clash-vs {
  font-family: 'Teko', sans-serif;
  font-size: 1.8rem;
  color: var(--gold);
}

.clash-banner {
  padding: 10px 14px;
  border-radius: 12px;
  font-weight: 800;
  font-size: 1.05rem;
  letter-spacing: 0.04em;
  animation: scorePop 0.35s ease;
}

.clash-banner--runs,
.clash-banner--win {
  background: rgba(16, 185, 129, 0.24);
  border: 1px solid var(--emerald);
  color: #6ee7b7;
}

.clash-banner--big {
  background: rgba(251, 191, 36, 0.24);
  border: 1px solid var(--gold);
  color: var(--gold);
}

.clash-banner--out,
.clash-banner--lose {
  background: rgba(239, 68, 68, 0.26);
  border: 1px solid var(--crimson);
  color: #fca5a5;
}

.bot-locked-pill {
  padding: 8px 12px;
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px dashed rgba(251, 191, 36, 0.45);
  color: #fde68a;
  font-size: 0.84rem;
  font-weight: 600;
}

.rules-reminder {
  margin-top: 14px;
  font-size: 0.78rem;
  color: var(--text-muted);
}

/* ================= WEBCAM PANEL ================= */
.webcam-panel {
  background: var(--bg-card);
  border: 1px solid var(--border-glass);
  backdrop-filter: blur(12px);
  border-radius: 18px;
  padding: 12px;
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  font-weight: 700;
  margin-bottom: 10px;
}

.status-chip {
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 0.7rem;
  background: rgba(30, 41, 59, 0.9);
  border: 1px solid var(--border-glass);
}
.status-chip--ready { color: #34d399; border-color: rgba(16, 185, 129, 0.5); }
.status-chip--loading { color: var(--gold); }
.status-chip--error { color: #fca5a5; border-color: var(--crimson); }

.webcam-viewport {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background: #020617;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.24);
}

.webcam-video,
.webcam-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scaleX(-1);
}

.webcam-overlay-msg {
  position: absolute;
  inset: 0;
  background: rgba(2, 6, 23, 0.84);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 18px;
  gap: 10px;
  z-index: 3;
}

.spinner {
  width: 32px;
  height: 32px;
  border: 3px solid rgba(56, 189, 248, 0.25);
  border-top-color: var(--cyan);
  border-radius: 50%;
  animation: spin 0.85s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.detected-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  background: rgba(2, 6, 23, 0.82);
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 12px;
  padding: 6px 12px;
  text-align: center;
}

.detected-badge.is-valid {
  border-color: var(--emerald);
  box-shadow: 0 0 14px rgba(16, 185, 129, 0.35);
}

.detected-label {
  display: block;
  font-size: 0.62rem;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

.detected-badge strong {
  font-family: 'Teko', sans-serif;
  font-size: 2rem;
  line-height: 1;
  color: #fff;
}

.stability-bar-wrap {
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: 10px;
  z-index: 2;
  background: rgba(2, 6, 23, 0.8);
  padding: 6px 10px;
  border-radius: 10px;
}

.stability-bar-label {
  font-size: 0.7rem;
  font-weight: 700;
  margin-bottom: 4px;
  color: #e2e8f0;
}

.stability-track {
  height: 7px;
  background: rgba(148, 163, 184, 0.25);
  border-radius: 999px;
  overflow: hidden;
}

.stability-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--cyan), var(--emerald));
  transition: width 0.08s linear;
}

.webcam-telemetry {
  margin-top: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.telemetry-hint {
  font-size: 0.8rem;
  color: #cbd5e1;
}

.finger-pills {
  display: flex;
  gap: 4px;
}

.finger-pill {
  width: 22px;
  height: 22px;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.68rem;
  font-weight: 800;
  background: rgba(30, 41, 59, 0.9);
  color: #64748b;
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.finger-pill.is-up {
  background: rgba(16, 185, 129, 0.24);
  color: #34d399;
  border-color: var(--emerald);
}

/* Fallback Gesture Pad */
.pad-subtitle {
  font-size: 0.82rem;
  color: var(--text-muted);
  margin: 0 0 12px;
}

.gesture-pad-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.pad-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 8px;
  border-radius: 12px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.25);
  color: #fff;
  cursor: pointer;
  transition: transform 0.14s ease, border-color 0.15s ease;
}

.pad-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  border-color: var(--cyan);
}

.pad-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.pad-num {
  font-family: 'Teko', sans-serif;
  font-size: 1.35rem;
  line-height: 1;
  color: var(--gold);
}

/* ================= INNINGS BREAK & MATCH RESULT ================= */
.break-score-box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--border-glass);
  border-radius: 16px;
  padding: 18px;
  margin-bottom: 18px;
}

.break-score-box span {
  display: block;
  font-size: 0.78rem;
  color: var(--text-muted);
}

.break-score-box strong {
  font-family: 'Teko', sans-serif;
  font-size: 3rem;
  line-height: 1;
}

.break-target strong { color: var(--gold); }
.break-arrow { font-size: 2rem; color: var(--cyan); }

.result-confetti {
  font-size: 2.2rem;
  margin-bottom: 4px;
  animation: scorePop 0.8s ease infinite alternate;
}

.result-screen--PLAYER .result-title { color: var(--emerald); }
.result-screen--BOT .result-title { color: var(--crimson); }
.result-screen--TIE .result-title { color: var(--gold); }

.result-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-bottom: 22px;
}

.stat-box {
  background: rgba(15, 23, 42, 0.85);
  border: 1px solid var(--border-glass);
  border-radius: 12px;
  padding: 10px 14px;
  text-align: left;
}

.stat-box span {
  display: block;
  font-size: 0.76rem;
  color: var(--text-muted);
}

.stat-box strong {
  font-size: 1rem;
  color: #f8fafc;
}

.result-actions {
  display: flex;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
}

/* ================= MODALS ================= */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  background: rgba(2, 6, 23, 0.78);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.modal-card {
  width: min(500px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  background: #0f172a;
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 20px;
  padding: 20px 22px;
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65);
}

.modal-card--wide {
  width: min(780px, 100%);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.modal-header h2 {
  font-family: 'Teko', sans-serif;
  font-size: 1.8rem;
  margin: 0;
}

.modal-close {
  background: rgba(30, 41, 59, 0.9);
  border: 1px solid var(--border-glass);
  color: #fff;
  width: 34px;
  height: 34px;
  border-radius: 8px;
  cursor: pointer;
}

.howto-steps {
  display: grid;
  gap: 10px;
  margin-bottom: 18px;
}

.howto-step {
  display: flex;
  gap: 12px;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid var(--border-glass);
  border-radius: 12px;
  padding: 12px;
}

.step-num {
  width: 28px;
  height: 28px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--cyan);
  color: #020617;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.howto-step h4 { margin: 0 0 4px; }
.howto-step p { margin: 0; font-size: 0.88rem; color: #cbd5e1; }

.guide-subheading {
  margin: 8px 0 10px;
  font-size: 1rem;
  color: var(--gold);
}

.gesture-guide-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  gap: 8px;
}

.guide-item {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(2, 6, 23, 0.65);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 10px;
  padding: 8px;
}

.guide-item-info {
  display: flex;
  flex-direction: column;
  font-size: 0.78rem;
}

.guide-item-info strong { color: var(--cyan); }
.guide-item-info span { color: #cbd5e1; }

.modal-footer {
  margin-top: 16px;
  display: flex;
  justify-content: flex-end;
}

.settings-list {
  display: grid;
  gap: 12px;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  background: rgba(2, 6, 23, 0.55);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 12px;
  padding: 12px 14px;
}

.setting-row strong { display: block; font-size: 0.94rem; }
.setting-row span { font-size: 0.78rem; color: var(--text-muted); }

.setting-row--col {
  flex-direction: column;
  align-items: stretch;
}

.difficulty-pills {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

.diff-pill {
  padding: 8px;
  border-radius: 8px;
  border: 1px solid var(--border-glass);
  background: rgba(30, 41, 59, 0.8);
  color: #cbd5e1;
  font-weight: 700;
  cursor: pointer;
}

.diff-pill.is-active {
  background: rgba(34, 211, 238, 0.22);
  border-color: var(--cyan);
  color: #fff;
}

.settings-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
  margin-top: 6px;
}

/* ================= RESPONSIVE ================= */
@media (max-width: 960px) {
  .match-arena {
    grid-template-columns: 1fr;
  }

  .arena-col--center {
    order: -1;
  }

  .toss-choice-buttons,
  .decision-buttons,
  .result-stats-grid {
    grid-template-columns: 1fr;
  }
}
