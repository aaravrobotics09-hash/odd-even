### 15. `src/App.css`

Modern cricket-broadcast styling with animated stadium floodlights, pitch & scoreboard graphics, responsive mobile & desktop grids, gesture cards, and smooth score/outcome animations.

```css
:root {
  --bg-deep: #060d1f;
  --bg-card: rgba(12, 23, 48, 0.86);
  --border-glass: rgba(148, 163, 184, 0.22);
  --cyan: #22d3ee;
  --emerald: #10b981;
  --gold: #fbbf24;
  --crimson: #ef4444;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Outfit', system-ui, -apple-system, sans-serif;
  background: var(--bg-deep);
  color: var(--text-main);
  min-height: 100vh;
  overflow-x: hidden;
}

.app-shell {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ================= ANIMATED STADIUM BACKGROUND ================= */
.stadium-bg {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
  background: radial-gradient(circle at 50% 15%, #122854 0%, #071024 55%, #030712 100%);
}

.stadium-sky-glow {
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 50% 45%, rgba(16, 185, 129, 0.14), transparent 65%);
  transition: background 0.5s ease;
}

.stadium-bg--wicket .stadium-sky-glow {
  background: radial-gradient(ellipse at 50% 45%, rgba(239, 68, 68, 0.28), transparent 65%);
}

.stadium-bg--gold .stadium-sky-glow {
  background: radial-gradient(ellipse at 50% 45%, rgba(251, 191, 36, 0.26), transparent 65%);
}

.floodlight-tower {
  position: absolute;
  top: 4%;
  width: 66px;
  z-index: 1;
}

.floodlight-tower--left {
  left: 4%;
}

.floodlight-tower--right {
  right: 4%;
}

.floodlight-head {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 5px;
  padding: 8px;
  background: #1e293b;
  border: 2px solid #475569;
  border-radius: 8px;
}

.floodlight-head span {
  display: block;
  height: 10px;
  border-radius: 3px;
  background: #e0f2fe;
  box-shadow: 0 0 14px #7dd3fc, 0 0 28px #38bdf8;
  animation: floodPulse 3.5s ease-in-out infinite alternate;
}

.floodlight-beam {
  position: absolute;
  top: 28px;
  width: 420px;
  height: 520px;
  background: linear-gradient(
    to bottom,
    rgba(186, 230, 253, 0.17),
    rgba(56, 189, 248, 0.04) 60%,
    transparent
  );
  clip-path: polygon(10% 0, 26% 0, 100% 100%, 0% 100%);
  animation: beamSweep 8s ease-in-out infinite alternate;
}

.floodlight-beam--left {
  left: -10px;
  transform-origin: top left;
}

.floodlight-beam--right {
  right: -10px;
  clip-path: polygon(74% 0, 90% 0, 100% 100%, 0% 100%);
  transform-origin: top right;
}

@keyframes floodPulse {
  0% { opacity: 0.8; }
  100% { opacity: 1; }
}

@keyframes beamSweep {
  0% { transform: rotate(-2deg); }
  100% { transform: rotate(3deg); }
}

.bg-stadium-scoreboard {
  position: absolute;
  top: 74px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 6px 18px;
  border-radius: 999px;
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid rgba(56, 189, 248, 0.25);
  color: rgba(148, 163, 184, 0.65);
  font-size: 0.72rem;
  letter-spacing: 0.22em;
}

.bg-sb-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--emerald);
  box-shadow: 0 0 8px var(--emerald);
}

.stadium-tiers {
  position: absolute;
  bottom: 24%;
  left: -10%;
  right: -10%;
  height: 160px;
  border-radius: 50% 50% 0 0;
  border-top: 3px solid rgba(56, 189, 248, 0.2);
  background: radial-gradient(ellipse at 50% 100%, rgba(30, 41, 59, 0.6), transparent 70%);
}

.stadium-outfield {
  position: absolute;
  bottom: -14%;
  left: 50%;
  transform: translateX(-50%) perspective(650px) rotateX(58deg);
  width: min(1150px, 120vw);
  height: 460px;
  border-radius: 50%;
  background: radial-gradient(circle, #0f5132 0%, #064e3b 55%, #022c22 100%);
  border: 5px solid rgba(255, 255, 255, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
}

.boundary-rope {
  position: absolute;
  inset: 18px;
  border-radius: 50%;
  border: 2px dashed rgba(251, 191, 36, 0.55);
}

.cricket-pitch {
  position: relative;
  width: 94px;
  height: 270px;
  background: linear-gradient(180deg, #b0895c 0%, #c49b6c 50%, #a47e53 100%);
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 6px;
}

.crease-line {
  position: absolute;
  left: -14px;
  right: -14px;
  height: 2px;
  background: rgba(255, 255, 255, 0.75);
}
.crease-line--top { top: 26px; }
.crease-line--bottom { bottom: 26px; }

.stumps-mini {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 3px;
}
.stumps-mini--top { top: 12px; }
.stumps-mini--bottom { bottom: 12px; }

.stumps-mini span {
  width: 3px;
  height: 14px;
  background: #fde68a;
  border-radius: 2px;
}

.stadium-particles span {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: rgba(251, 191, 36, 0.45);
  animation: floatParticle 10s linear infinite;
}
.stadium-particles span:nth-child(1) { left: 15%; top: 75%; animation-duration: 9s; }
.stadium-particles span:nth-child(2) { left: 32%; top: 82%; animation-duration: 12s; }
.stadium-particles span:nth-child(3) { left: 48%; top: 70%; animation-duration: 8s; }
.stadium-particles span:nth-child(4) { left: 65%; top: 85%; animation-duration: 11s; }
.stadium-particles span:nth-child(5) { left: 82%; top: 72%; animation-duration: 10s; }
.stadium-particles span:nth-child(6) { left: 90%; top: 88%; animation-duration: 13s; }

@keyframes floatParticle {
  0% { transform: translateY(0) scale(1); opacity: 0; }
  20% { opacity: 0.7; }
  100% { transform: translateY(-280px) scale(0.4); opacity: 0; }
}

/* ================= TOP NAV & STAGE ================= */
.top-nav {
  position: relative;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 24px;
  background: rgba(6, 13, 31, 0.8);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border-glass);
}

.brand-mini {
