Manages the full game flow (`HOME → TOSS_CHOICE → TOSS_PLAY → TOSS_RESULT → BAT_BOWL_DECISION → INNINGS_1 → INNINGS_BREAK → INNINGS_2 → MATCH_RESULT`), fair pre-turn hidden Bot selection, simultaneous reveals, cricket scoring, target chasing, tie handling, and match summary stats.

```jsx
import React, { useEffect, useRef, useState } from 'react';
import StadiumBackground from './components/StadiumBackground';
import HandIcon from './components/HandIcon';
import { PlayerAvatar, BotAvatar } from './components/Avatars';
import Scoreboard from './components/Scoreboard';
import WebcamPanel from './components/WebcamPanel';
import { HowToPlayModal, SettingsModal } from './components/Modals';
import { GESTURE_DESCRIPTIONS } from './utils/gestureRecognizer';
import {
  pickBotTossCall,
  pickBotBatOrBowl,
  selectBotNumber,
  getBotReaction,
} from './utils/botAI';
import { soundEngine } from './utils/soundEngine';

const INITIAL_MATCH = {
  playerTossChoice: null,
  botTossChoice: null,
  tossPlayerNum: null,
  tossBotNum: null,
  tossWinner: null, // 'PLAYER' | 'BOT'
  firstBatter: null, // 'PLAYER' | 'BOT'
  innings: 1,
  battingSide: null, // 'PLAYER' | 'BOT'
  playerScore: 0,
  playerWickets: 0,
  playerBalls: 0,
  botScore: 0,
  botWickets: 0,
  botBalls: 0,
  target: null,
  lastBall: null,
  lastResult: '',
  ballHistory: [],
  playerPastNumbers: [],
  winner: null, // 'PLAYER' | 'BOT' | 'TIE'
  summary: '',
};

export default function App() {
  const [screen, setScreen] = useState('HOME');
  const [match, setMatch] = useState(INITIAL_MATCH);
  const [settings, setSettings] = useState({
    sfxEnabled: true,
    voiceEnabled: true,
    webcamEnabled: true,
    difficulty: 'medium',
  });

  const [showHowTo, setShowHowTo] = useState(false);
  const [showSettings, setShowSettings] = useState(false);

  // Turn synchronization: Bot picks its secret number BEFORE player reveals gesture
  const [turnPhase, setTurnPhase] = useState('WAITING'); // 'WAITING' | 'REVEALING'
  const [turnId, setTurnId] = useState(1);
  const [revealedPair, setRevealedPair] = useState(null); // { player, bot, label, type }
  const [scorePulseKey, setScorePulseKey] = useState(0);

  const [botExpression, setBotExpression] = useState('neutral');
  const [botQuip, setBotQuip] = useState('Show me your best hand!');
  const [botDecisionText, setBotDecisionText] = useState('');

  const botSecretRef = useRef(null);
  const timerRef = useRef(null);

  const clearPendingTimer = () => {
    if (timerRef.current) {
      clearTimeout(timerRef.current);
      timerRef.current = null;
    }
  };

  useEffect(() => {
    soundEngine.setSettings({
      sfxEnabled: settings.sfxEnabled,
      voiceEnabled: settings.voiceEnabled,
    });
  }, [settings.sfxEnabled, settings.voiceEnabled]);

  useEffect(() => {
    return () => clearPendingTimer();
  }, []);

  const updateSettings = (patch) => {
    setSettings((prev) => ({ ...prev, ...patch }));
  };

  const prepareNextTurn = (role, pastNums = [], runsNeeded = null, diff = settings.difficulty) => {
    // Bot independently locks its number BEFORE the player shows or locks any gesture
    botSecretRef.current = selectBotNumber({
      difficulty: diff,
      role,
      playerPastNumbers: pastNums,
      runsNeeded,
    });
    setTurnPhase('WAITING');
    setRevealedPair(null);
    setTurnId((id) => id + 1);
  };

  const startNewMatch = () => {
    clearPendingTimer();
    soundEngine.playClick();
    setMatch(INITIAL_MATCH);
    setBotExpression('neutral');
    setBotQuip('Ready for the toss! Call Odd or Even.');
    setBotDecisionText('');
    setRevealedPair(null);
    setScreen('TOSS_CHOICE');
  };

  const returnToMainMenu = () => {
    clearPendingTimer();
    soundEngine.playClick();
    setMatch(INITIAL_MATCH);
    setScreen('HOME');
  };

  // Step 1: Player chooses ODD or EVEN
  const handleChooseToss = (choice) => {
    soundEngine.playClick();
    const botCall = pickBotTossCall();
    setMatch((prev) => ({
      ...prev,
      playerTossChoice: choice,
      botTossChoice: botCall,
    }));
    setBotExpression('thinking');
    setBotQuip('I locked my secret toss number. Show yours!');
    prepareNextTurn('TOSS');
    setScreen('TOSS_PLAY');
    soundEngine.speak(`You chose ${choice}. Show your number for the toss!`);
  };

  // Step 2: Handle confirmed player gesture during TOSS_PLAY
  const handleTossGesture = (playerNum) => {
    if (turnPhase !== 'WAITING') return;
    const botNum = botSecretRef.current ?? selectBotNumber({ role: 'TOSS' });
    const sum = playerNum + botNum;
    const parity = sum % 2 === 0 ? 'EVEN' : 'ODD';
    const playerWon = parity === match.playerTossChoice;
    const tossWinner = playerWon ? 'PLAYER' : 'BOT';

    setTurnPhase('REVEALING');
    soundEngine.playTossFlip();

    setRevealedPair({
      player: playerNum,
      bot: botNum,
      label: `${playerNum} + ${botNum} = ${sum} (${parity})`,
      type: playerWon ? 'win' : 'lose',
    });

    setBotExpression(playerWon ? 'surprised' : 'happy');
    setBotQuip(getBotReaction(playerWon ? 'botLostToss' : 'botWonToss'));

    setMatch((prev) => ({
      ...prev,
      tossPlayerNum: playerNum,
      tossBotNum: botNum,
      tossWinner,
    }));

    clearPendingTimer();
    timerRef.current = setTimeout(() => {
      setScreen('TOSS_RESULT');
      soundEngine.speak(
        playerWon
          ? `Total is ${sum}, ${parity}. You won the toss!`
          : `Total is ${sum}, ${parity}. Bot won the toss!`
      );
    }, 2200);
  };

  // Step 3: Advance from TOSS_RESULT to BAT_BOWL_DECISION
  const handleProceedToDecision = () => {
    soundEngine.playClick();
    setScreen('BAT_BOWL_DECISION');

    if (match.tossWinner === 'BOT') {
      const botChoice = pickBotBatOrBowl(settings.difficulty);
      const firstBatter = botChoice === 'BAT' ? 'BOT' : 'PLAYER';
      setBotExpression('confident');
      setBotDecisionText(
        botChoice === 'BAT' ? 'BOT CHOSE TO BAT FIRST!' : 'BOT CHOSE TO BOWL FIRST!'
      );
      setBotQuip(
        botChoice === 'BAT'
          ? 'I am putting a huge score on the board!'
          : 'Put your pads on — I am bowling first!'
      );
      soundEngine.speak(
        botChoice === 'BAT' ? 'Bot chose to bat first!' : 'Bot chose to bowl first!'
      );

      clearPendingTimer();
      timerRef.current = setTimeout(() => {
        beginInnings1(firstBatter);
      }, 2200);
    }
  };

  const beginInnings1 = (firstBatter) => {
    soundEngine.playClick();
    setMatch((prev) => ({
      ...prev,
      firstBatter,
      innings: 1,
      battingSide: firstBatter,
      lastBall: null,
      lastResult: '',
      ballHistory: [],
    }));
    setBotExpression('neutral');
    setBotQuip(firstBatter === 'PLAYER' ? 'Try hitting past my bowling!' : 'Time to score big!');
    prepareNextTurn(firstBatter === 'PLAYER' ? 'BOWLING' : 'BATTING', [], null);
    setScreen('INNINGS_1');
    soundEngine.speak(
      firstBatter === 'PLAYER' ? 'First innings begins. You are batting!' : 'First innings begins. Bot is batting!'
    );
  };

  const beginInnings2 = () => {
    soundEngine.playClick();
    const secondBatter = match.firstBatter === 'PLAYER' ? 'BOT' : 'PLAYER';
    const firstScore = match.firstBatter === 'PLAYER' ? match.playerScore : match.botScore;
    const target = firstScore + 1;

    setMatch((prev) => ({
      ...prev,
      innings: 2,
      battingSide: secondBatter,
      target,
      lastBall: null,
      lastResult: '',
      ballHistory: [],
    }));

    setBotExpression('confident');
    setBotQuip(
      secondBatter === 'BOT'
        ? `Target ${target}! Let the chase begin!`
        : `Defending ${firstScore}! Good luck chasing ${target}!`
    );

    prepareNextTurn(
      secondBatter === 'PLAYER' ? 'BOWLING' : 'BATTING',
      match.playerPastNumbers,
      secondBatter === 'BOT' ? target : null
    );
    setScreen('INNINGS_2');
    soundEngine.speak(`Second innings! Target is ${target} runs.`);
  };

  // Cricket ball delivery handler for Innings 1 & 2
  const handleCricketBall = (playerNum) => {
    if (turnPhase !== 'WAITING') return;

    const isPlayerBatting = match.battingSide === 'PLAYER';
    const botRole = isPlayerBatting ? 'BOWLING' : 'BATTING';
    const runsNeeded =
      match.innings === 2 && !isPlayerBatting && match.target !== null
        ? match.target - match.botScore
        : null;

    const botNum =
      botSecretRef.current ??
      selectBotNumber({
        difficulty: settings.difficulty,
        role: botRole,
        playerPastNumbers: match.playerPastNumbers,
        runsNeeded,
      });

    setTurnPhase('REVEALING');
    const isOut = playerNum === botNum;
    const runs = isOut ? 0 : isPlayerBatting ? playerNum : botNum;
    const resultText = isOut ? 'OUT!' : `+${runs} RUN${runs === 1 ? '' : 'S'}`;

    if (isOut) {
      soundEngine.playWicket();
    } else {
      soundEngine.playBatHit(runs);
    }

    setScorePulseKey((k) => k + 1);
    setRevealedPair({
      player: playerNum,
      bot: botNum,
      label: resultText,
      type: isOut ? 'out' : runs >= 6 ? 'big' : 'runs',
    });

    // Bot expression & quip
    if (isOut) {
      if (isPlayerBatting) {
        setBotExpression('happy');
        setBotQuip(getBotReaction('botTookWicket'));
        soundEngine.speak(`Out! Both showed ${playerNum}!`);
      } else {
        setBotExpression('disappointed');
        setBotQuip(getBotReaction('botOut'));
        soundEngine.speak(`Bot is out on ${botNum}!`);
      }
    } else if (!isPlayerBatting) {
      if (runs >= 6) {
        setBotExpression('confident');
        setBotQuip(getBotReaction('botScoredBig'));
      } else {
        setBotExpression('happy');
        setBotQuip(getBotReaction('botScoredSmall'));
      }
      if (runs >= 7) soundEngine.speak(`Massive ${runs} runs by the Bot!`);
    } else {
      setBotExpression(runs >= 7 ? 'surprised' : 'neutral');
      setBotQuip(getBotReaction('botMissedWicket'));
      if (runs >= 7) soundEngine.speak(`Huge ${runs} runs!`);
    }

    // Compute updated scoreboard state
    const updatedPastNums = [...match.playerPastNumbers, playerNum];
    const newPlayerScore = isPlayerBatting ? match.playerScore + runs : match.playerScore;
    const newPlayerWickets = isPlayerBatting && isOut ? 1 : match.playerWickets;
    const newPlayerBalls = isPlayerBatting ? match.playerBalls + 1 : match.playerBalls;

    const newBotScore = !isPlayerBatting ? match.botScore + runs : match.botScore;
    const newBotWickets = !isPlayerBatting && isOut ? 1 : match.botWickets;
    const newBotBalls = !isPlayerBatting ? match.botBalls + 1 : match.botBalls;

    const updatedHistory = [
      ...match.ballHistory,
      { player: playerNum, bot: botNum, runs, isOut },
    ];

    setMatch((prev) => ({
      ...prev,
      playerScore: newPlayerScore,
      playerWickets: newPlayerWickets,
      playerBalls: newPlayerBalls,
      botScore: newBotScore,
      botWickets: newBotWickets,
      botBalls: newBotBalls,
      lastBall: { player: playerNum, bot: botNum },
      lastResult: resultText,
      ballHistory: updatedHistory,
      playerPastNumbers: updatedPastNums,
    }));

    clearPendingTimer();
    timerRef.current = setTimeout(() => {
      if (match.innings === 1) {
        if (isOut) {
          setScreen('INNINGS_BREAK');
          const firstScore = isPlayerBatting ? newPlayerScore : newBotScore;
          soundEngine.speak(`Innings break! Target is ${firstScore + 1} runs.`);
        } else {
          prepareNextTurn(botRole, updatedPastNums, null);
        }
      } else {
        // Innings 2 chase evaluation
        const chasingScore = isPlayerBatting ? newPlayerScore : newBotScore;
        const target = match.target;
        const firstScore = target - 1;

        if (chasingScore >= target) {
          // Chasing team wins immediately!
          const winner = isPlayerBatting ? 'PLAYER' : 'BOT';
          finishMatch(winner, newPlayerScore, newBotScore, updatedPastNums, isPlayerBatting);
        } else if (isOut) {
          if (chasingScore === firstScore) {
            finishMatch('TIE', newPlayerScore, newBotScore, updatedPastNums, isPlayerBatting);
          } else {
            const winner = isPlayerBatting ? 'BOT' : 'PLAYER';
            finishMatch(winner, newPlayerScore, newBotScore, updatedPastNums, isPlayerBatting);
          }
        } else {
          const nextNeeded = target - chasingScore;
          prepareNextTurn(botRole, updatedPastNums, !isPlayerBatting ? nextNeeded : null);
        }
      }
    }, 2200);
  };

  const finishMatch = (winner, pScore, bScore) => {
    let summary = '';
    if (winner === 'TIE') {
      summary = `An epic deadlock! Both sides finished level on ${pScore} runs.`;
      soundEngine.playTossFlip();
      soundEngine.speak('What a thriller! The match is tied!');
    } else if (winner === 'PLAYER') {
      const margin = pScore - bScore;
      summary =
        match.battingSide === 'PLAYER'
          ? `You chased down the target with ${pScore} runs on the board!`
          : `You defended your total and beat the Bot by ${margin} run${margin === 1 ? '' : 's'}!`;
      soundEngine.playVictory();
      soundEngine.speak('Congratulations! You won the match!');
    } else {
      const margin = bScore - pScore;
      summary =
        match.battingSide === 'BOT'
          ? `Cricko-Bot chased down the target finishing on ${bScore} runs.`
          : `Cricko-Bot defended its total and won by ${margin} run${margin === 1 ? '' : 's'}.`;
      soundEngine.playDefeat();
      soundEngine.speak('Cricko-Bot wins the match!');
    }

    setBotExpression(winner === 'BOT' ? 'happy' : winner === 'PLAYER' ? 'disappointed' : 'surprised');
    setMatch((prev) => ({
      ...prev,
      winner,
      summary,
    }));
    setScreen('MATCH_RESULT');
  };

  const handleTurnGesture = (num) => {
    soundEngine.playLock();
    if (screen === 'TOSS_PLAY') {
      handleTossGesture(num);
    } else if (screen === 'INNINGS_1' || screen === 'INNINGS_2') {
      handleCricketBall(num);
    }
  };

  const isInMatch =
    screen !== 'HOME' && screen !== 'MATCH_RESULT';

  const currentInningsBalls =
    match.battingSide === 'PLAYER' ? match.playerBalls : match.botBalls;

  const stadiumHighlight =
    revealedPair?.type === 'out'
      ? 'wicket'
      : revealedPair?.type === 'big' || screen === 'MATCH_RESULT'
      ? 'gold'
      : 'neutral';

  return (
    <div className="app-shell">
      <StadiumBackground highlight={stadiumHighlight} />

      {/* Top Navigation Bar */}
      <nav className="top-nav">
        <div className="brand-mini" onClick={returnToMainMenu} role="button" tabIndex={0}>
          <span>🏏</span> ODD EVEN HAND CRICKET
        </div>
        <div className="nav-actions">
          <button type="button" className="icon-btn" onClick={() => setShowHowTo(true)}>
            ❓ How to Play
          </button>
          <button type="button" className="icon-btn" onClick={() => setShowSettings(true)}>
            ⚙️ Settings
          </button>
        </div>
      </nav>

      {/* Live Cricket Scoreboard during Innings */}
      {(screen === 'INNINGS_1' || screen === 'INNINGS_2') && (
        <Scoreboard
          playerScore={match.playerScore}
          playerWickets={match.playerWickets}
          botScore={match.botScore}
          botWickets={match.botWickets}
          innings={match.innings}
          target={match.target}
          ballsPlayed={currentInningsBalls}
          lastBall={match.lastBall}
          lastResult={match.lastResult}
          battingSide={match.battingSide}
          ballHistory={match.ballHistory}
          scorePulseKey={scorePulseKey}
        />
      )}

      <main className="stage-container">
        {/* SCREEN 1: HOME SCREEN */}
        {screen === 'HOME' && (
          <section className="home-screen">
            <div className="hero-card">
              <div className="hero-eyebrow">AI WEBCAM STADIUM EDITION</div>
              <h1 className="hero-title">ODD EVEN HAND CRICKET</h1>
              <p className="hero-subtitle">Challenge the Bot!</p>
              <p className="hero-desc">
                Step onto the virtual pitch with real-time webcam hand tracking! Win the Odd-Even
                toss, outsmart Cricko-Bot with custom gestures 1–9, smash big runs, and defend
                your stumps.
              </p>

              <div className="hero-cta">
                <button type="button" className="btn btn-primary btn-lg" onClick={startNewMatch}>
                  🏏 START GAME
                </button>
                <button
                  type="button"
                  className="btn btn-secondary btn-lg"
                  onClick={() => {
                    soundEngine.playClick();
                    setShowHowTo(true);
                  }}
                >
                  📖 HOW TO PLAY
                </button>
              </div>
            </div>

            <div className="home-guide-card">
              <div className="guide-card-head">
                <h2>✋ HAND GESTURE REFERENCE GUIDE (1–9)</h2>
                <span>Works with Left or Right Hand</span>
              </div>
              <div className="home-gesture-grid">
                {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((num) => (
                  <div key={num} className="gesture-tile">
                    <div className="gesture-tile-num">{num}</div>
                    <HandIcon number={num} size={56} />
                    <p>{GESTURE_DESCRIPTIONS[num]}</p>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        {/* SCREEN 2: ODD-EVEN SELECTION */}
        {screen === 'TOSS_CHOICE' && (
          <section className="center-card toss-choice-screen">
            <div className="stage-tag">PRE-MATCH COINLESS TOSS</div>
            <h2>CHOOSE YOUR TOSS</h2>
            <p>
              Pick <strong>ODD</strong> or <strong>EVEN</strong>. Both you and Cricko-Bot will show
              a number from 1 to 9 simultaneously—the parity of the sum decides the toss winner!
            </p>
            <div className="toss-choice-buttons">
              <button
                type="button"
                className="toss-option-btn toss-option-btn--odd"
                onClick={() => handleChooseToss('ODD')}
              >
                <span className="toss-opt-title">ODD</span>
                <span className="toss-opt-sub">Sum = 3, 5, 7, 9, 11...</span>
              </button>
              <button
                type="button"
                className="toss-option-btn toss-option-btn--even"
                onClick={() => handleChooseToss('EVEN')}
              >
                <span className="toss-opt-title">EVEN</span>
                <span className="toss-opt-sub">Sum = 2, 4, 6, 8, 10...</span>
              </button>
            </div>
          </section>
        )}

        {/* SCREEN 3: PLAY THE TOSS ("SHOW YOUR NUMBER!") */}
        {screen === 'TOSS_PLAY' && (
          <section className="match-arena">
            <div className="arena-col arena-col--left">
              <PlayerAvatar statusText={`Called: ${match.playerTossChoice}`} />
              <WebcamPanel
                webcamEnabled={settings.webcamEnabled}
                canLock={turnPhase === 'WAITING'}
                turnId={turnId}
                onConfirmNumber={handleTurnGesture}
                onEnableFallback={() => updateSettings({ webcamEnabled: false })}
              />
            </div>

            <div className="arena-col arena-col--center">
              <div className="clash-panel">
                <div className="stage-tag">TOSS IN PROGRESS</div>
                <h2 className="clash-headline">SHOW YOUR NUMBER!</h2>
                <p className="clash-sub">
                  You called <strong>{match.playerTossChoice}</strong> • Bot&apos;s call:{' '}
                  <strong>{revealedPair ? match.botTossChoice : 'HIDDEN 🔒'}</strong>
                </p>

                <div className="clash-cards">
                  <div className={`num-card ${revealedPair ? 'is-revealed' : ''}`}>
                    <span className="num-card-label">YOU</span>
                    <strong>{revealedPair ? revealedPair.player : '?'}</strong>
                  </div>
                  <div className="clash-plus">+</div>
                  <div className={`num-card num-card--bot ${revealedPair ? 'is-revealed' : ''}`}>
                    <span className="num-card-label">BOT</span>
                    <strong>{revealedPair ? revealedPair.bot : '🔒'}</strong>
                  </div>
                </div>

                {revealedPair ? (
                  <div className={`clash-banner clash-banner--${revealedPair.type}`}>
                    {revealedPair.label}
                  </div>
                ) : (
                  <div className="bot-locked-pill">✓ Bot has locked its hidden number</div>
                )}
              </div>
            </div>

            <div className="arena-col arena-col--right">
              <BotAvatar
                expression={botExpression}
                quip={botQuip}
                difficulty={settings.difficulty}
              />
            </div>
          </section>
        )}

        {/* SCREEN 4: TOSS RESULT */}
        {screen === 'TOSS_RESULT' && (
          <section className="center-card toss-result-screen">
            <div className="stage-tag">TOSS RESULT</div>
            <h2 className={match.tossWinner === 'PLAYER' ? 'text-win' : 'text-lose'}>
              {match.tossWinner === 'PLAYER' ? '🏆 YOU WON THE TOSS!' : '🤖 BOT WON THE TOSS!'}
            </h2>

            <div className="toss-breakdown">
              <div className="breakdown-row">
                <span>Your Toss Call</span>
                <strong>{match.playerTossChoice}</strong>
              </div>
              <div className="breakdown-row">
                <span>Bot&apos;s Secret Prediction</span>
                <strong>{match.botTossChoice}</strong>
              </div>
              <div className="breakdown-row">
                <span>Numbers Revealed</span>
                <strong>
                  You: {match.tossPlayerNum} + Bot: {match.tossBotNum} ={' '}
                  {match.tossPlayerNum + match.tossBotNum} (
                  {(match.tossPlayerNum + match.tossBotNum) % 2 === 0 ? 'EVEN' : 'ODD'})
                </strong>
              </div>
            </div>

            <button
              type="button"
              className="btn btn-primary btn-lg"
              onClick={handleProceedToDecision}
            >
              {match.tossWinner === 'PLAYER' ? 'CHOOSE BAT OR BOWL →' : 'SEE BOT DECISION →'}
            </button>
          </section>
        )}

        {/* SCREEN 5: BAT OR BOWL DECISION */}
        {screen === 'BAT_BOWL_DECISION' && (
          <section className="center-card decision-screen">
            <div className="stage-tag">INNINGS ORDER</div>
            {match.tossWinner === 'PLAYER' ? (
              <>
                <h2>MAKE YOUR CALL!</h2>
                <p>You won the toss. Would you like to set a target or chase?</p>
                <div className="decision-buttons">
                  <button
                    type="button"
                    className="decision-btn"
                    onClick={() => beginInnings1('PLAYER')}
                  >
                    <span className="dec-icon">🏏</span>
                    <strong>BAT FIRST</strong>
                    <span>Set a big target</span>
                  </button>
                  <button
                    type="button"
                    className="decision-btn"
                    onClick={() => beginInnings1('BOT')}
                  >
                    <span className="dec-icon">⚾</span>
                    <strong>BOWL FIRST</strong>
                    <span>Bowl out the Bot &amp; chase</span>
                  </button>
                </div>
              </>
            ) : (
              <div className="bot-decision-anim">
                <BotAvatar
                  expression="confident"
                  quip={botQuip}
                  difficulty={settings.difficulty}
                />
                <h2 className="bot-decision-title">{botDecisionText}</h2>
                <p>Preparing pitch for the 1st Innings...</p>
              </div>
            )}
          </section>
        )}

        {/* SCREEN 6 & 8: INNINGS 1 & INNINGS 2 GAMEPLAY */}
        {(screen === 'INNINGS_1' || screen === 'INNINGS_2') && (
          <section className="match-arena">
            <div className="arena-col arena-col--left">
              <PlayerAvatar
                isBatting={match.battingSide === 'PLAYER'}
                statusText={
                  match.battingSide === 'PLAYER'
                    ? `Score: ${match.playerScore} (${match.playerBalls}b)`
                    : `Bowling`
                }
              />
              <WebcamPanel
                webcamEnabled={settings.webcamEnabled}
                canLock={turnPhase === 'WAITING'}
                turnId={turnId}
                onConfirmNumber={handleTurnGesture}
                onEnableFallback={() => updateSettings({ webcamEnabled: false })}
              />
            </div>

            <div className="arena-col arena-col--center">
              <div className="clash-panel">
                <div className="innings-banner">
                  {match.battingSide === 'PLAYER' ? '🏏 YOU ARE BATTING' : '🤖 BOT IS BATTING'}
                </div>

                {match.innings === 2 && match.target !== null && (
                  <div className="chase-tracker">
                    Need{' '}
                    <strong>
                      {Math.max(
                        0,
                        match.target -
                          (match.battingSide === 'PLAYER' ? match.playerScore : match.botScore)
                      )}
                    </strong>{' '}
                    more run(s) to win
                  </div>
                )}

                <div className="clash-cards">
                  <div className={`num-card ${revealedPair ? 'is-revealed' : ''}`}>
                    <span className="num-card-label">YOUR HAND</span>
                    <strong>{revealedPair ? revealedPair.player : '?'}</strong>
                  </div>
                  <div className="clash-vs">VS</div>
                  <div className={`num-card num-card--bot ${revealedPair ? 'is-revealed' : ''}`}>
                    <span className="num-card-label">BOT HAND</span>
                    <strong>{revealedPair ? revealedPair.bot : '🔒'}</strong>
                  </div>
                </div>

                {revealedPair ? (
                  <div className={`clash-banner clash-banner--${revealedPair.type}`}>
                    {revealedPair.label}
                  </div>
                ) : (
                  <div className="bot-locked-pill">
                    ✓ Bot delivery locked — show your gesture (1–9)!
                  </div>
                )}

                <div className="rules-reminder">
                  Same number = <strong>OUT!</strong> • Different numbers ={' '}
                  <strong>{match.battingSide === 'PLAYER' ? 'YOUR' : 'BOT'} RUNS!</strong>
                </div>
              </div>
            </div>

            <div className="arena-col arena-col--right">
              <BotAvatar
                expression={botExpression}
                isBatting={match.battingSide === 'BOT'}
                quip={botQuip}
                difficulty={settings.difficulty}
              />
            </div>
          </section>
        )}

        {/* SCREEN 7: INNINGS BREAK */}
        {screen === 'INNINGS_BREAK' && (
          <section className="center-card innings-break-screen">
            <div className="stage-tag">INNINGS BREAK</div>
            <h2>END OF 1ST INNINGS!</h2>
            <div className="break-score-box">
              <div>
                <span>
                  {match.firstBatter === 'PLAYER' ? 'YOUR SCORE' : "BOT'S SCORE"}
                </span>
                <strong>
                  {match.firstBatter === 'PLAYER' ? match.playerScore : match.botScore}/1
                </strong>
              </div>
              <div className="break-arrow">→</div>
              <div className="break-target">
                <span>
                  {match.firstBatter === 'PLAYER' ? "BOT'S TARGET" : 'YOUR TARGET'}
                </span>
                <strong>
                  {(match.firstBatter === 'PLAYER' ? match.playerScore : match.botScore) + 1}
                </strong>
              </div>
            </div>
            <p>
              Roles are now switching!{' '}
              {match.firstBatter === 'PLAYER'
                ? 'Time to bowl Cricko-Bot out before it reaches the target!'
                : 'Put on your pads and chase down the target!'}
            </p>
            <button type="button" className="btn btn-primary btn-lg" onClick={beginInnings2}>
              START 2ND INNINGS →
            </button>
          </section>
        )}

        {/* SCREEN 9: FINAL MATCH RESULT */}
        {screen === 'MATCH_RESULT' && (
          <section className={`center-card result-screen result-screen--${match.winner}`}>
            <div className="result-confetti" aria-hidden="true">
              {match.winner === 'PLAYER' ? '🏆🎉🏏✨' : match.winner === 'TIE' ? '⚡🤝⚡' : '🤖🏏'}
            </div>
            <div className="stage-tag">FULL TIME</div>
            <h2 className="result-title">
              {match.winner === 'PLAYER'
                ? 'YOU WON!'
                : match.winner === 'BOT'
                ? 'BOT WON!'
                : 'MATCH TIED!'}
            </h2>
            <p className="result-summary">{match.summary}</p>

            <div className="result-stats-grid">
              <div className="stat-box">
                <span>Your Final Score</span>
                <strong>
                  {match.playerScore}/{match.playerWickets} ({match.playerBalls} balls)
                </strong>
              </div>
              <div className="stat-box">
                <span>Bot&apos;s Final Score</span>
                <strong>
                  {match.botScore}/{match.botWickets} ({match.botBalls} balls)
                </strong>
              </div>
              <div className="stat-box">
                <span>Total Match Runs</span>
                <strong>{match.playerScore + match.botScore}</strong>
              </div>
              <div className="stat-box">
                <span>Total Balls Played</span>
                <strong>{match.playerBalls + match.botBalls}</strong>
              </div>
              <div className="stat-box">
                <span>Toss Winner</span>
                <strong>{match.tossWinner === 'PLAYER' ? 'YOU' : 'BOT'}</strong>
              </div>
              <div className="stat-box">
                <span>Batted First</span>
                <strong>{match.firstBatter === 'PLAYER' ? 'YOU' : 'BOT'}</strong>
              </div>
            </div>

            <div className="result-actions">
              <button type="button" className="btn btn-primary btn-lg" onClick={startNewMatch}>
                🔄 PLAY AGAIN
              </button>
              <button
                type="button"
                className="btn btn-secondary btn-lg"
                onClick={returnToMainMenu}
              >
                🏠 MAIN MENU
              </button>
            </div>
          </section>
        )}
      </main>

      <HowToPlayModal isOpen={showHowTo} onClose={() => setShowHowTo(false)} />
      <SettingsModal
        isOpen={showSettings}
        onClose={() => setShowSettings(false)}
        settings={settings}
        onUpdateSettings={updateSettings}
        onRestartMatch={startNewMatch}
        onReturnHome={returnToMainMenu}
        inMatch={isInMatch}
      />
    </div>
  );
}
```

